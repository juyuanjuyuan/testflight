# Copy to .env and fill in. Never commit .env.
SCIFORIUM_API_KEY=
SCIFORIUM_BASE_URL=https://api.sciforium.com/v1
# Exact model strings handed out at compute setup (Saturday).
# Sciforium requires a deployment prefix in the model field: /deployments/<ID>/<org>/<model>
# (e.g. /deployments/<ID>/deepseek-ai/DeepSeek-V4.1-Flash). Each model has its own <ID>; bare names return
# "400 Invalid model deployment target". Base URL stays at /v1.
MODEL_PLANNER=          # DeepSeek V4.1 Flash — frequent, cheap calls
MODEL_JUDGE=            # GLM 5.3 Flash — judge + fixer
MODEL_VISION=           # optional; leave empty to skip the vision check
VISION_API_KEY=         # optional; own key if Sciforium image input doesn't work
VISION_BASE_URL=

CHROME_BIN=             # optional; path to a local Chromium if Playwright's download isn't available
CDP_ENDPOINT=           # real-site mode only, e.g. http://localhost:9222
LLM_CACHE=readwrite     # off | readwrite | readonly (use readonly for the live demo)
