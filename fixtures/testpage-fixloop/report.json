  "findings": [
    {
      "id": "F1",
      "detector": "unannounced",
      "layer": "announcement",
      "steps": [
        2,
        8
      ],
      "wcag": [
        "4.1.3"
      ],
      "hint": "\"Added to cart\" appeared 3ms after Enter; not in a live region, focus not moved to it, not described by newly focused element",
      "evidence": {
        "selector": "#toast",
        "barrierId": "T2",
        "text": "Added to cart",
        "screenshot": "shots/0002.png"
      },
      "impact": "block",
      "summary": "The \"Added to cart\" and \"Order confirmed\" toasts (#toast) are plain divs with no live-region role, no focus move, and no aria-describedby, so they are never announced.",
      "userImpact": "A screen-reader user gets no feedback that the tote was added or that the card payment succeeded, so they cannot tell whether the order was placed and abandon the purchase.",
      "judged": true,
      "axeAlsoFound": true,
      "fix": {
        "edits": [
          {
            "file": "index.html",
            "old": "<div id=\"toast\" data-barrier=\"T2\"></div>",
            "new": "<div id=\"toast\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\" data-barrier=\"T2\"></div>"
          }
        ],
        "rationale": "The #toast element is a plain div, so updates to its text ('Added to cart', 'Order confirmed') are not announced by screen readers. Adding role=\"status\" with aria-live=\"polite\" (and aria-atomic=\"true\" so the whole message is read) makes it a live region that announces these status messages without changing any visible text or behavior."
      },
      "candidateId": "C1"
    },
